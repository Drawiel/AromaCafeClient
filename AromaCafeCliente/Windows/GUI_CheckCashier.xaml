<Page x:Class="AromaCafeCliente.Windows.GUI_CheckCashier"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AromaCafeCliente.Windows"
      xmlns:controls="clr-namespace:AromaCafeCliente.Windows.UserControllers"
      mc:Ignorable="d" 
      Title="GUI_CheckCashier">

    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Multimedia/GUI_CuentaCajero.png"/>
    </Page.Background>

    <Viewbox
        Stretch="Uniform">
        <Grid
        Height="1080"
        Width="1920">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="323*"/>
                <ColumnDefinition Width="1597*"/>
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ValidationPopupPaymentMethod"
                Width="1000"
                Height="500"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Hidden"
                Panel.ZIndex="2"
                Margin="460,0,0,0" Grid.ColumnSpan="2">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpPaymentMethod.png"/>
                </Grid.Background>
                <ComboBox
                Name="comboBoxPaymentMethod"
                Padding="10,10,0,0"
                HorizontalAlignment="Left" 
                Margin="319,0,0,0" 
                Width="548" Height="54"
                FontSize="40"
                FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

                <Button 
                x:Name="btnAcceptPaymentMethod"
                HorizontalAlignment="Left" 
                Margin="830,405,0,0" 
                VerticalAlignment="Top" 
                Height="55" 
                Width="136">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAccept.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    x:Name="btnCancelPaymentMethod"
                    HorizontalAlignment="Left" 
                    Margin="673,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

            <Grid
                x:Name="ValidationPopupModifyOrder"
                Width="1000"
                Height="500"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Hidden"
                Panel.ZIndex="2"
                Margin="460,0,0,0" Grid.ColumnSpan="2">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpModificarPedido.png"/>
                </Grid.Background>
                <TextBox
                Name="txtBoxNewCuantity"
                Padding="10,10,0,0"
                HorizontalAlignment="Left" 
                Margin="355,223,0,223" 
                Width="548" Height="54"
                FontSize="40"
                FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

                <Button 
                x:Name="btnAcceptModifyOrder"
                HorizontalAlignment="Left" 
                Margin="830,405,0,0" 
                VerticalAlignment="Top" 
                Height="55" 
                Width="136">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAccept.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    x:Name="btnCancelModifyOrder"
                    HorizontalAlignment="Left" 
                    Margin="673,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

            <Grid
                Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="373*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="291*"/>
                    <RowDefinition Height="85*"/>
                </Grid.RowDefinitions>

                <Grid
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="85"
                Width="323"
                Background="Transparent">
                    <Button
                    Click="NavigateHome"
                    Grid.Row="1"
                    x:Name="Home"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverHome.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

                <Grid
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="85"
                Width="323"
                Background="Transparent">
                    <Button
                    Click="NavigateTables"
                    Grid.Row="1"
                    x:Name="Users"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverTables.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

                <Grid
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="85"
                Width="323"
                Background="Transparent">
                    <Button
                    Grid.Row="1"
                    x:Name="Report"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverBills.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

                <Grid
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="85"
                Width="323"
                Background="Transparent">
                    <Button
                    Grid.Row="1"
                    x:Name="Products"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCashOut.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>


                <Grid
                Grid.Row="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Height="85"
                Width="323"
                Background="Transparent">
                    <Button
                    Grid.Row="1"
                    x:Name="LogOut"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323"
                    Click="LogOut_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverLogOut.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>


            </Grid>
            <Grid
                Grid.Column="1"
                Width="1530"
                Height="955"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                
                <Button
                    x:Name="btnCloseBill"
                    HorizontalAlignment="Left" 
                    Height="60" Margin="1279,869,0,0" 
                    VerticalAlignment="Top" 
                    Width="172"
                    Click="btnCloseBill_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverClose.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    x:Name="btnModifyOrder"
                    HorizontalAlignment="Left" 
                    Height="60" Margin="1068,869,0,0" 
                    VerticalAlignment="Top" 
                    Width="172">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverModify.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    Click="BtnGoBack_Click"
                    HorizontalAlignment="Left" 
                    Height="47" 
                    Margin="34,75,0,0" 
                    VerticalAlignment="Top" 
                    Width="64">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverBack.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Grid Margin="162,227,163,92">

                    <DataGrid 
                        x:Name="dataGridBill"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding Products}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ColumnHeaderHeight="58" 
                        GridLinesVisibility="All"
                        Background="Transparent"
                        Margin="0,-73,-3,25"
                        SelectionUnit="FullRow"
                        SelectionMode="Single"
                        SelectionChanged="DataGridUserSelectionChanged"
                        Foreground="Black"
                        FontSize="25">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding ProductName}" Width="770" IsReadOnly="True"/>
                            <DataGridTextColumn Header="" Binding="{Binding Quantity}" Width="227" IsReadOnly="True"/>
                            <DataGridTextColumn Header="" Binding="{Binding Price}" Width="212" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

            </Grid>
            <!-- Popup de confirmación para cerrar sesión -->
            <Border x:Name="ValidationPopup"
        Grid.ColumnSpan="2"
        Background="#80000000"
        Visibility="Hidden"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Panel.ZIndex="100">

                <controls:GUI_PopUp_LogOut x:Name="LogOutPopupControl"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="1000"
                               Height="500"/>
            </Border>

            <Border x:Name="ExpensesPopUp"
		Grid.ColumnSpan="2"
		Background="#80000000"
		Visibility="Hidden"
		VerticalAlignment="Stretch"
		HorizontalAlignment="Stretch"
		Panel.ZIndex="100">

                <controls:GUI_PopUp_Bills x:Name="ExpensesPopupControl"
       HorizontalAlignment="Center"
       VerticalAlignment="Center"
       Width="1000"
       Height="500"/>
            </Border>

        </Grid>
    </Viewbox>
</Page>
