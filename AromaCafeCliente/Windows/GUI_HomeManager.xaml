<Page x:Class="AromaCafeCliente.Windows.GUI_HomeManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:AromaCafeCliente.Windows"
      xmlns:controls="clr-namespace:AromaCafeCliente.Windows.UserControllers"
      mc:Ignorable="d"
      Title="GUI_HomeManager">

    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Multimedia/GUI_InicioGerente.png"/>
    </Page.Background>

    <Viewbox Stretch="Uniform">
        <Grid Height="1080" Width="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="323*"/>
                <ColumnDefinition Width="1597*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="373*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="291*"/>
                    <RowDefinition Height="85*"/>
                </Grid.RowDefinitions>

                <!-- Botón Home -->
                <Grid Grid.Row="1" Background="Transparent">
                    <Button x:Name="Home" Height="85" Width="323">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverHome.png"
                                                            Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Botón Users -->
                <Grid Grid.Row="2" Background="Transparent">
                    <Button x:Name="Users" Height="85" Width="323">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverUsers.png"
                                                            Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Botón Report -->
                <Grid Grid.Row="3" Background="Transparent">
                    <Button x:Name="Report" Height="85" Width="323">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverReports.png"
                                                            Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Botón Products -->
                <Grid Grid.Row="4" Background="Transparent">
                    <Button x:Name="Products" Height="85" Width="323">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverProducts.png"
                                                            Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Botón LogOut -->
                <Grid Grid.Row="6" Background="Transparent">
                    <Button x:Name="LogOut" Height="85" Width="323" Click="LogOut_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent"
                                            Width="{TemplateBinding Width}"
                                            Height="{TemplateBinding Height}" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverLogOut.png"
                                                            Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>

            <Border x:Name="ValidationPopup"
                    Grid.ColumnSpan="2"
                    Background="#80000000"
                    Visibility="Hidden"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Panel.ZIndex="100">

                    <controls:GUI_PopUp_LogOut x:Name="LogOutPopupControl" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Width="1000"
                                           Height="500"/>
            </Border>
        </Grid>
    </Viewbox>
</Page>
