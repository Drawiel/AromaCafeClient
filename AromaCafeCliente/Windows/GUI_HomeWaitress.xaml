    <Page.Resources>
        <Style x:Key="ClosedTableStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="DarkRed" Opacity="0.6"/>
                    <!-- 60% de opacidad -->
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="DarkRed" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation
            Storyboard.TargetName="ConfirmationPopup"
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.3"/>
            <DoubleAnimation
            Storyboard.TargetName="ErrorPopup"
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOutStoryboard_Completed">
            <DoubleAnimation
            Storyboard.TargetName="ConfirmationPopup"
            Storyboard.TargetProperty="Opacity"
            From="1"
            To="0"
            Duration="0:0:0.3"/>
            <DoubleAnimation
            Storyboard.TargetName="ErrorPopup"
            Storyboard.TargetProperty="Opacity"
            From="1"
            To="0"
            Duration="0:0:0.3"/>
        </Storyboard>
    </Page.Resources>

