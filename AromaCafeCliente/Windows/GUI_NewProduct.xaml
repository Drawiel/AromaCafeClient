<Page x:Class="AromaCafeCliente.Windows.GUI_NewProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AromaCafeCliente.Windows"
      xmlns:controls="clr-namespace:AromaCafeCliente.Windows.UserControllers"
      mc:Ignorable="d" 

      Title="GUI_NewProduct"  Height="1080" Width="1920">


    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Multimedia/GUI_AgregarProducto.png"/>
    </Page.Background>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="323*"/>
            <ColumnDefinition Width="1597*"/>
        </Grid.ColumnDefinitions>


        <Grid
                Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="373*"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="85*"/>
                <RowDefinition Height="291*"/>
                <RowDefinition Height="85*"/>
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="1"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Height="85"
                Width="323"
                Background="Transparent">
                <Button
                    Grid.Row="1"
                    x:Name="Home" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Height="85"
                    Width="323" 
                    Click="Home_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverHome.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>

            <Grid
                Grid.Row="2"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Height="85"
                Width="323"
                Background="Transparent">
                <Button
                    Grid.Row="1"
                    x:Name="Users" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Height="85"
                    Width="323" 
                    Click="Users_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverUsers.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>

            <Grid
                Grid.Row="3"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Height="85"
                Width="323"
                Background="Transparent">
                <Button
                    Grid.Row="1"
                    x:Name="Report" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Height="85"
                    Width="323" 
                    Click="Report_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverReports.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>

            <Grid
                Grid.Row="4"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Height="85"
                Width="323"
                Background="Transparent">
                <Button
                    Grid.Row="1"
                    x:Name="Products" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Height="85"
                    Width="323" 
                    Click="Products_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverProducts.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>


            <Grid
                Grid.Row="6"
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch" 
                Height="85"
                Width="323"
                Background="Transparent">
                <Button
                    Grid.Row="1"
                    x:Name="LogOut" 
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch" 
                    Height="85"
                    Width="323" 
                    Click="LogOut_Click_1">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverLogOut.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>
            </Grid>


        </Grid>
        <Viewbox
            Grid.Column="1">

            <Grid
            Width="1597"
            Height="1080"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBox
                            x:Name="TxtBoxName"
                            Padding="10,0,10,0"
                            FontFamily="pack://application:,,,/Font/#Architects Daughter"
                            HorizontalAlignment="Left"
                            FontSize="40"
                            Margin="391,169,0,0" 
                            TextWrapping="Wrap" 
                            Text="" 
                            VerticalAlignment="Top" 
                            Width="1018" 
                            Height="60"/>

                </Grid>

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBox
                        x:Name="txtBoxCode"
                        Padding="10,0,10,0"
                        FontFamily="pack://application:,,,/Font/#Architects Daughter"
                        HorizontalAlignment="Left"
                        FontSize="40"
                        Margin="389,259,0,0" 
                        TextWrapping="Wrap" 
                        Text="" 
                        VerticalAlignment="Top" 
                        Width="1020" 
                        Height="60"/>

                </Grid>

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBox
                        x:Name="txtBoxUnits"
                        Padding="10,0,10,0"
                        FontFamily="pack://application:,,,/Font/#Architects Daughter"
                        HorizontalAlignment="Left"
                        FontSize="40"
                        Margin="389,349,0,0" 
                        TextWrapping="Wrap" 
                        Text="" 
                        VerticalAlignment="Top" 
                        Width="1020" 
                        Height="60"/>

                </Grid>

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <TextBox
                        x:Name="txtBoxDesciption"
                        Padding="10,0,10,0"
                        FontFamily="pack://application:,,,/Font/#Architects Daughter"
                        HorizontalAlignment="Left"
                        FontSize="40"
                        Margin="389,441,0,0" 
                        TextWrapping="Wrap" 
                        Text="" 
                        VerticalAlignment="Top" 
                        Width="1019" 
                        Height="148"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"/>

                </Grid>

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <ComboBox
                        x:Name="txtBoxNumber"
                        Padding="10,0,10,0"
                        FontFamily="pack://application:,,,/Font/#Architects Daughter"
                        HorizontalAlignment="Left"
                        FontSize="40"
                        Margin="390,619,0,0" 
                        Text="" 
                        VerticalAlignment="Top" 
                        Width="465" 
                        Height="60">


                        <ComboBoxItem Content="Primario" Tag="Primario" />
                        <ComboBoxItem Content="Carta"  Tag="Carta"/>
                    </ComboBox>

                </Grid>

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <ComboBox
                        x:Name="comboBoxGroup"
                        Padding="10,0,10,0"
                        FontFamily="pack://application:,,,/Font/#Architects Daughter"
                        HorizontalAlignment="Left"
                        FontSize="40"
                        Margin="387,709,0,0" 
                        Text="" 
                        VerticalAlignment="Top" 
                        Width="465" 
                        Height="60">


                        <ComboBoxItem Content="Bebidas Frias" Tag="Primario" />
                        <ComboBoxItem Content="Bebidas Calientes"  Tag="Carta"/>
                        <ComboBoxItem Content="Postres" Tag="Primario" />
                        <ComboBoxItem Content="Extras"  Tag="Carta"/>
                        <ComboBoxItem Content="Alimentos" Tag="Primario" />
                        <ComboBoxItem Content="Entradas"  Tag="Carta"/>
                        <ComboBoxItem Content="Mixologia" Tag="Primario" />
                    </ComboBox>

                </Grid>

                <Grid
                        Width="1530"
                        Height="955"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <TextBox
                            x:Name="txtBoxPrice"
                            Padding="45,0,10,0"
                            FontFamily="pack://application:,,,/Font/#Architects Daughter"
                            HorizontalAlignment="Left"
                            FontSize="40"
                            Margin="390,799,0,0" 
                            Text="" 
                            VerticalAlignment="Top" 
                            Width="465"
                            IsEnabled="True"
                            Height="60">
                    </TextBox>
                </Grid>

                <Grid
                    Width="1530"
                    Height="955"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left" Margin="57,49,0,0">

                    <Button 
                        x:Name="btnRegister"
                        HorizontalAlignment="Left" 
                        Margin="1218,860,0,0" 
                        VerticalAlignment="Top" 
                        Height="59" 
                        Width="167" Click="btnRegister_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverRegister.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                    <Button 
                        x:Name="btnCancel"
                        HorizontalAlignment="Left" 
                        Margin="1052,860,0,0" 
                        VerticalAlignment="Top" 
                        Height="59" 
                        Width="156"
                        Click="Products_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>

                </Grid>
                <!-- Popup de confirmación para cerrar sesión -->
                <Border x:Name="ValidationPopup"
                    Grid.ColumnSpan="2"
                    Background="#80000000"
                    Visibility="Hidden"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Panel.ZIndex="100">

                    <controls:GUI_PopUp_LogOut x:Name="LogOutPopupControl"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="1000"
                               Height="500"/>
                </Border>


            </Grid>
        </Viewbox>




    </Grid>
</Page>
