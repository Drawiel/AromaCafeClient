<Page x:Class="AromaCafeCliente.Windows.GUI_Reports"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AromaCafeCliente.Windows"
      xmlns:controls="clr-namespace:AromaCafeCliente.Windows.UserControllers"
      mc:Ignorable="d" 
      Title="GUI_Reports">

    <Page.Resources>
        <!-- Animación para mostrar -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation
            Storyboard.TargetName="ConfirmationPopup"
            Storyboard.TargetProperty="Opacity"
            From="0"
            To="1"
            Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Animación para ocultar -->
        <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOutStoryboard_Completed">
            <DoubleAnimation
            Storyboard.TargetName="ConfirmationPopup"
            Storyboard.TargetProperty="Opacity"
            From="1"
            To="0"
            Duration="0:0:0.3"/>
        </Storyboard>
    </Page.Resources>


    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Multimedia/GUI_Reportes.png"/>
    </Page.Background>

    <Viewbox>

        <Grid
        Height="1080"
        Width="1920">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="323*"/>
                <ColumnDefinition Width="1597*"/>
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="ValidationPopupPeriod"
                Width="1000"
                Height="500"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Hidden"
                Panel.ZIndex="2"
                Margin="460,0,0,0" Grid.ColumnSpan="2">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpPeriodo.png"/>
                </Grid.Background>
                <ComboBox
                    Name="comboBoxPeriod"
                    Padding="10,10,0,0"
                    HorizontalAlignment="Left" 
                    Margin="338,0,0,0" 
                    Width="548" Height="54"
                    FontSize="40"
                    FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

                <Button 
                    x:Name="btnAccept"
                    HorizontalAlignment="Left" 
                    Margin="830,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAccept.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    x:Name="btnCancel"
                    HorizontalAlignment="Left" 
                    Margin="673,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

            <Grid
                x:Name="ValidationPopupDate"
                Width="1000"
                Height="500"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Visibility="Hidden"
                Panel.ZIndex="2"
                Margin="460,0,0,0" Grid.ColumnSpan="2" Cursor="">
                <Grid.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpFecha.png"/>
                </Grid.Background>
                <DatePicker
                    Name="datePicker"
                    Padding="10,10,0,0"
                    HorizontalAlignment="Left" 
                    Margin="338,0,0,0" 
                    Width="548" Height="54"
                    FontSize="40"
                    FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

                <Button 
                    x:Name="btnAcceptDatePicker"
                    HorizontalAlignment="Left" 
                    Margin="830,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136"
                    Click="ExpensesPerDay_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAccept.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    x:Name="btnCancelDatePicker"
                    HorizontalAlignment="Left" 
                    Margin="673,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136"
                    Click="DatePopupHidden_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>

            <Grid
                Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="373*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="85*"/>
                    <RowDefinition Height="291*"/>
                    <RowDefinition Height="85*"/>
                </Grid.RowDefinitions>

                <Grid
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323"
                    Background="Transparent">
                    <Button
                        Grid.Row="1"
                        x:Name="Home"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
					    Height="85"
					    Width="323"
                        Click="NavigateHome">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverHome.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

                <Grid
                    Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323"
                    Background="Transparent">
                    <Button
                        Grid.Row="1"
                        x:Name="Users"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
					    Height="85"
					    Width="323"
                        Click="NavigateEmployees">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverUsers.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

                <Grid
                    Grid.Row="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323"
                    Background="Transparent">
                    <Button
                        Grid.Row="1"
                        x:Name="Report"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
					    Height="85"
					    Width="323"
                        Click="NavigateReports">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverReports.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

                <Grid
                    Grid.Row="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323"
                    Background="Transparent">
                    <Button
                        Grid.Row="1"
                        x:Name="Products"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
					    Height="85"
					    Width="323"
                        Click="NavigateProductList">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverProducts.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>


                <Grid
                    Grid.Row="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Height="85"
                    Width="323"
                    Background="Transparent">
                    <Button
                        Grid.Row="1"
                        x:Name="LogOut"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
					    Height="85"
					    Width="323"
                        Click="LogOut_Click">

                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- Fondo normal -->
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- Cambiar fondo cuando el mouse esté encima -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverLogOut.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>

                    </Button>
                </Grid>

            </Grid>

            <Grid
                Grid.Column="1">
                <Button 
                    HorizontalAlignment="Left" 
                    Margin="113,192,0,0" 
                    VerticalAlignment="Top" 
                    Height="210" 
                    Width="399">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverVentaPorPeriodo.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    HorizontalAlignment="Left" 
                    Margin="592,192,0,0" 
                    VerticalAlignment="Top" 
                    Height="210" 
                    Width="399">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverVentasPorMesero.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    HorizontalAlignment="Left" 
                    Margin="1072,192,0,0" 
                    VerticalAlignment="Top" 
                    Height="210" 
                    Width="399"
                    Click="DatePopupVisible_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverGastosPorPeriodo.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    HorizontalAlignment="Left" 
                    Margin="113,678,0,0" 
                    VerticalAlignment="Top" 
                    Height="210" 
                    Width="399"
                    Click="GenerateInventoryReport">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverReporteDeInventario.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    HorizontalAlignment="Left" 
                    Margin="592,678,0,0" 
                    VerticalAlignment="Top" 
                    Height="210" 
                    Width="399">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverPedidosPorMesa.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

                <Button 
                    HorizontalAlignment="Left" 
                    Margin="1072,678,0,0" 
                    VerticalAlignment="Top" 
                    Height="210" 
                    Width="399">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Fondo normal -->
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Cambiar fondo cuando el mouse esté encima -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancelacionesPorMesa.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>

                </Button>

            </Grid>
            <!-- Popup de confirmación para cerrar sesión -->
            <Border x:Name="ValidationPopup"
                Grid.ColumnSpan="2"
                Background="#80000000"
                Visibility="Hidden"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="100">

                <controls:GUI_PopUp_LogOut x:Name="LogOutPopupControl"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="1000"
                               Height="500"/>
            </Border>

            <Border x:Name="ConfirmationPopup"
                Grid.ColumnSpan="2"
                Background="#80000000"
                Visibility="Hidden"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                Panel.ZIndex="100"
                Opacity="0">

                <controls:GUI_PopUp_ConfirmationMessage x:Name="ConfirmationMessagePopupControl"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Width="1000"
                               Height="500"/>
            </Border>
        </Grid>
    </Viewbox>
</Page>
