<Page x:Class="AromaCafeCliente.Windows.GUI_WaitersTableBill"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AromaCafeCliente.Windows"
      mc:Ignorable="d" 
      Title="GUI_WaitersTableBill">

    <Page.Background>
        <ImageBrush ImageSource="pack://application:,,,/Multimedia/GUI_CuentaMesaMesero.png"/>
    </Page.Background>

    <Viewbox
        Stretch="Uniform">

        <Grid
            Height="1080"
            Width="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700*"/>
                <ColumnDefinition Width="1197*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer 
                Margin="14,11,0,0"
                VerticalScrollBarVisibility="Auto" 
                HorizontalScrollBarVisibility="Auto"
                CanContentScroll="True"
                Background="Transparent" 
                Height="880" Width="601">

                <DataGrid 
                    x:Name="dataGridProducts"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding Productos}"
                    ColumnHeaderHeight="61" 
                    GridLinesVisibility="All"
                    Background="Transparent"
                    SelectionUnit="FullRow"
                    SelectionMode="Single"
                    FontSize="20"
                    HeadersVisibility="Column"
                    RowHeight="40"
                    BorderBrush="#7B4224"
                    BorderThickness="1"
                    Width="601" 
                    Height="Auto"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.Columns>
                        <DataGridTextColumn 
                                Binding="{Binding Producto}" 
                                Width="404"
                                IsReadOnly="True"/>

                        <DataGridTextColumn 
                                Binding="{Binding Cantidad}" 
                                Width="105" 
                                IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="" Width="92">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Seleccionado}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>

            <Grid
                Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210"/>
                    <RowDefinition Height="400"/>
                    <RowDefinition Height="470"/>
                </Grid.RowDefinitions>

                <Button 
                    x:Name="btnEntry"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="23,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button 
                    x:Name="btnFood"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="188,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button 
                    x:Name="btnHootDrinks"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="353,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button 
                    x:Name="btnColdDrinks"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="518,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button 
                    x:Name="btnDesserts"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="682,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button 
                    x:Name="btnMixology"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="847,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button 
                    x:Name="btnExtras"
                    HorizontalAlignment="Left" 
                    Height="97" 
                    Margin="847,84,0,0" 
                    VerticalAlignment="Top" 
                    Width="158">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBackground" Property="Background">
                                        <Setter.Value>
                                            <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverEntradas.png" Stretch="UniformToFill"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Grid
                    Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="995"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer 
                        Margin="14,11,0,0"
                        VerticalScrollBarVisibility="Auto" 
                        HorizontalScrollBarVisibility="Auto"
                        CanContentScroll="True"
                        Background="Transparent" 
                        Height="364" Width="950">

                        <DataGrid 
                            x:Name="dataGridGroupProduct"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            ItemsSource="{Binding Productos}"
                            ColumnHeaderHeight="61" 
                            GridLinesVisibility="All"
                            Background="Transparent"
                            SelectionUnit="FullRow"
                            SelectionMode="Single"
                            FontSize="20"
                            HeadersVisibility="Column"
                            RowHeight="40"
                            BorderBrush="#7B4224"
                            BorderThickness="1"
                            Width="950" 
                            Height="Auto"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <DataGrid.Columns>
                                <DataGridTextColumn 
                                        Binding="{Binding Producto}" 
                                        Width="801"
                                        IsReadOnly="True"/>

                                <DataGridTextColumn 
                                    Binding="{Binding Cantidad}" 
                                    Width="149" 
                                    IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <Button
                        x:Name="btnAdd"
                        Grid.Column="1" 
                        HorizontalAlignment="Left" 
                        Height="146" 
                        Margin="8,28,0,0" 
                        VerticalAlignment="Top" 
                        Width="158">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAgregar.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button
                        x:Name="btnSubtract"
                        Grid.Column="1" 
                        HorizontalAlignment="Left" 
                        Height="146" 
                        Margin="8,28,0,0" 
                        VerticalAlignment="Top" 
                        Width="158">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAgregar.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>

                <Grid
                    Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="995"/>
                        <ColumnDefinition Width="100*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer 
                        Margin="14,-74,0,0"
                        VerticalScrollBarVisibility="Auto" 
                        HorizontalScrollBarVisibility="Auto"
                        CanContentScroll="True"
                        Background="Transparent" 
                        Height="364" Width="950">

                        <DataGrid 
                            x:Name="dataGridNewProducts"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            ItemsSource="{Binding Productos}"
                            ColumnHeaderHeight="61" 
                            GridLinesVisibility="All"
                            Background="Transparent"
                            SelectionUnit="FullRow"
                            SelectionMode="Single"
                            FontSize="20"
                            HeadersVisibility="Column"
                            RowHeight="40"
                            BorderBrush="#7B4224"
                            BorderThickness="1"
                            Width="950" 
                            Height="Auto"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.VerticalScrollBarVisibility="Disabled"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                            <DataGrid.Columns>
                                <DataGridTextColumn 
                                        Binding="{Binding Producto}" 
                                        Width="702"
                                        IsReadOnly="True"/>

                                <DataGridTextColumn 
                                        Binding="{Binding Cantidad}" 
                                        Width="99"
                                        IsReadOnly="True"/>

                                <DataGridTextColumn 
                                    Binding="{Binding Precio}" 
                                    Width="149" 
                                    IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <Button
                        x:Name="btnCloseTable"
                        Grid.Column="1" 
                        HorizontalAlignment="Left" 
                        Height="146" 
                        Margin="8,78,0,0" 
                        VerticalAlignment="Top" 
                        Width="158">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCerrar.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button 
                        Grid.Column="1" 
                        HorizontalAlignment="Left" 
                        Height="60" Margin="12,320,0,0" 
                        VerticalAlignment="Top" 
                        Width="155">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ButtonBackground" Property="Background">
                                            <Setter.Value>
                                                <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>

            </Grid>




        </Grid>

    </Viewbox>

</Page>
