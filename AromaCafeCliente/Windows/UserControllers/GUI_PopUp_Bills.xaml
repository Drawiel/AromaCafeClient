<UserControl x:Class="AromaCafeCliente.Windows.UserControllers.GUI_PopUp_Bills"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AromaCafeCliente.Windows.UserControllers"
             mc:Ignorable="d">
    <Grid Width="1000" Height="500">
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpBills.png"/>
        </Grid.Background>

        <TextBox Name="txtBoxReason"
                     Padding="10,10,0,0"
                     HorizontalAlignment="Left" 
                     Margin="250,178,0,0" 
                     VerticalAlignment="Top" 
                     Width="696" Height="57"
                     FontSize="40"
                     FontFamily="pack://application:,,,/Font/#Architects Daughter"/>        
        <TextBox Name="txtBoxCuantity"
                     Padding="10,10,0,0"
                     HorizontalAlignment="Left" 
                     Margin="250,268,0,0" 
                     VerticalAlignment="Top" 
                     Width="696" Height="57"
                     FontSize="40"
                     FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

        <Button x:Name="btnAccept"
                HorizontalAlignment="Left" 
                Margin="832,408,0,0" 
                VerticalAlignment="Top" 
                Height="55" 
                Width="136"
                Click="BtnAccept_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAccept.png" Stretch="UniformToFill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button x:Name="btnCancel"
                HorizontalAlignment="Left" 
                Margin="675,408,0,0" 
                VerticalAlignment="Top" 
                Height="55" 
                Width="136"
                Click="BtnCancel_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>

