<UserControl x:Class="AromaCafeCliente.Windows.UserControllers.GUI_PopUp_DatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AromaCafeCliente.Windows.UserControllers"
             mc:Ignorable="d" >
    <Grid
                x:Name="ValidationPopupDatePicker"
                Width="1000"
                Height="500"
                Visibility="Visible"
                Panel.ZIndex="2"
                Grid.ColumnSpan="2">
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpFecha.png"/>
        </Grid.Background>
        <DatePicker
                    Name="comboBoxPeriod"
                    Padding="10,10,0,0"
                    HorizontalAlignment="Left" 
                    Margin="338,0,0,0" 
                    Width="548" Height="54"
                    FontSize="40"
                    FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

        <Button 
                    x:Name="btnAccept"
                    HorizontalAlignment="Left" 
                    Margin="830,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Fondo normal -->
                        <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Cambiar fondo cuando el mouse esté encima -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAccept.png" Stretch="UniformToFill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

        </Button>

        <Button 
                    x:Name="btnCancel"
                    HorizontalAlignment="Left" 
                    Margin="673,405,0,0" 
                    VerticalAlignment="Top" 
                    Height="55" 
                    Width="136">

            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Fondo normal -->
                        <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Cambiar fondo cuando el mouse esté encima -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverCancel.png" Stretch="UniformToFill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

        </Button>

    </Grid>

</UserControl>
