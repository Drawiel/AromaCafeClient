<UserControl x:Class="AromaCafeCliente.Windows.UserControllers.GUI_PopUp_ErrorMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AromaCafeCliente.Windows.UserControllers"
             mc:Ignorable="d" >

    <Grid
        Width="757"
        Height="480">
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Multimedia/popUpErrorMessage.png"/>
        </Grid.Background>
        <Button 
            x:Name="btnAccept"
            HorizontalAlignment="Left" 
            Height="60" 
            Margin="581,399,0,0" 
            VerticalAlignment="Top" 
            Width="156"
            Click="BtnAccept_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ButtonBackground" Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBackground" Property="Background">
                                <Setter.Value>
                                    <ImageBrush ImageSource="pack://application:,,,/Multimedia/HoverAcceptMessage.png" Stretch="UniformToFill"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock
            x:Name="txtBlockMessageError"
            HorizontalAlignment="Center" 
            Height="84" Margin="0,310,0,0" 
            TextWrapping="Wrap" 
            Text="TextBlock"
            FontSize="35"
            TextAlignment="Center"
            Foreground="#F6E9D8"
            VerticalAlignment="Top" 
            Width="572"
            FontFamily="pack://application:,,,/Font/#Architects Daughter"/>

    </Grid>
</UserControl>
